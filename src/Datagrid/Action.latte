{define action, string $name, string $label, int $id, ?string $class = null, ?string $icon = null, bool $danger = false}
	{* An item of the menu of a row. The grid state (filters, page, sorting) is added by Nette from the persistent parameters. *}
	<li>
		<a n:href="action!, name: $name, id: $id" data-naja-history="off" class="{$class ?? ($danger ? 'ajax dropdown-item text-danger' : 'ajax dropdown-item')}">
			<i n:if="$icon !== null" class="{$icon} me-2" aria-hidden="true"></i>{_$label}
		</a>
	</li>
{/define}
