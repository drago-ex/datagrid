{templateType Drago\Datagrid\DataGridTemplate}

{import 'Sortable.latte'}
{import 'Action.latte'}

{snippet dataGrid}
	{var $hasActiveFilters = array_filter($filters, fn($v) => $v !== null && $v !== '') !== []}

	{* in the inline mode the control renders only the form, its inputs are in the table header *}
	{if $hasFilters}
		{control filters}
	{/if}

	<table class="table table-sm table-borderless table-hover datagrid-table">
		<thead>
		<tr>
			{foreach $columns as $col}
				<th n:class="'fw-semibold', $col->getAlignClass()">
					{include 'sortable', sortable: $col->sortable, name: $col->name, label: ($col->label|translate)}
				</th>
			{/foreach}

			{if $actions !== []}
				<th class="fw-semibold text-end">&nbsp;</th>
			{elseif $hasFilters && $filterMode === 'inline'}
				<th></th>
			{/if}
		</tr>

		{if $hasFilters && $filterMode === 'inline'}
		<tr class="datagrid-filter-row">
			{foreach $columns as $col}
				<th class="p-1">
					{if $col->filter !== null}
						{var $isFilterActive = isset($filters[$col->name]) && $filters[$col->name] !== ''}
						<div n:class="'datagrid-filter-control', $isFilterActive ? 'input-group input-group-sm'">
							{if $col->filter->getInputType() === 'select'}
								<select
									name="{$col->name}"
									form="{$filterFormId}"
									class="form-select form-select-sm datagrid-control"
									data-items-filter>
									<option value="">{_'All'}</option>
									{foreach $col->filter->items as $value => $label}
										<option value="{$value}" n:attr="selected => ($filters[$col->name] ?? '') == $value">
											{$col->filter->translate ? ($label|translate) : $label}
										</option>
									{/foreach}
								</select>
							{else}
								<input
									type="{$col->filter->getInputType() === 'date' ? 'date' : 'text'}"
									name="{$col->name}"
									form="{$filterFormId}"
									class="form-control form-control-sm datagrid-control"
									data-items-filter
									value="{$filters[$col->name] ?? ''}"
									autocomplete="off">
							{/if}
							{if $isFilterActive}
								<a n:href="filters:clearFilter!, name: $col->name" class="btn btn-secondary btn-sm datagrid-filter-clear ajax" data-naja-history="replace" aria-label="{_'Clear filter'}">&times;</a>
							{/if}
						</div>
					{/if}
				</th>
			{/foreach}
			<th class="p-1">
				{if $hasActiveFilters}
					<a n:href="filters:resetFilters!" class="btn btn-secondary btn-sm datagrid-filter-button ajax" data-naja-history="replace">{_'Reset'}</a>
				{/if}
			</th>
		</tr>
		{/if}
		</thead>

		<tbody>
		{foreach $rows as $row}
			{* a row its condition leaves out is not clickable (handleAction() refuses it too) *}
			{var bool $clickable = $rowClick !== null && $primaryKey && $rowClick->isVisible((array) $row)}
			<tr n:class="$clickable ? 'datagrid-row-clickable ajax', $autoHideActions ? 'datagrid-actions-autohide'"
				n:attr="data-row-click-url => $clickable ? $control->link('action!', ['name' => $rowClickAction, 'id' => $row[$primaryKey]]) : null">
				{foreach $columns as $col}
					{* renderCell() escapes the value itself, only an Html object from a formatter stays HTML *}
					<td n:class="$col->getAlignClass()">{$col->renderCell((array) $row)|noescape}</td>
				{/foreach}

				{if $actions !== []}
					<td class="text-end">
						{foreach $actions as $ac}
							{if $ac->isVisible((array) $row)}
								{include 'action', name: $ac->name, label: $ac->label, id: $row[$primaryKey], class: $ac->class}
							{/if}
						{/foreach}
					</td>
				{/if}
			</tr>
		{/foreach}
		</tbody>
	</table>
	{include 'Footer.latte'}
{/snippet}
