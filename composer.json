{
	"name": "drago-ex/datagrid",
	"description": "A simple datagrid for sorting and filtering data.",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Zdeněk Papučík",
			"homepage": "https://github.com/accgit"
		}
	],
	"require": {
		"php": ">=8.3 <9",
		"latte/latte": "^3.1",
		"dibi/dibi": "^5.0",
		"nette/application": "^3.2",
		"nette/forms": "^3.2",
		"nette/utils": "^4.0"
	},
	"suggest": {
		"drago-ex/translator": "Configures Latte translation support for bundled templates using translation macros."
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan-nette": "^2.0"
	},
	"autoload": {
		"classmap": [
			"src/"
		],
		"psr-4": {
			"Drago\\": "src"
		}
	},
	"extra": {
		"drago-translator": {
			"translation": "src/Datagrid/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C"
	}
}
